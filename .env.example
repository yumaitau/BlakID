# Control-plane metadata database (not a tenant identity directory)
DATABASE_URL=postgres://blakid:blakid@127.0.0.1:55432/blakid_control

# Signed control-plane session cookie (generate with: openssl rand -base64 48)
BLAKID_SESSION_SECRET=change-me-to-a-long-random-value

# Runtime: memory (tests/dev without Docker) | compose (dedicated authentik stacks)
# Production must set BLAKID_ENV=production and BLAKID_RUNTIME=compose.
BLAKID_ENV=development
BLAKID_RUNTIME=memory

# Default sovereignty region for managed deployments
BLAKID_DEFAULT_REGION=ap-southeast-2
BLAKID_DEFAULT_REGION_LABEL=Australia — Sydney
BLAKID_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Production key custody and write-once audit. Required when BLAKID_ENV=production.
# BLAKID_KMS_KEY_ID=arn:aws:kms:ap-southeast-2:ACCOUNT:key/KEY
# BLAKID_KMS_DATA_KEY=base64-data-key-unwrapped-via-kms
# BLAKID_AUDIT_DIR=/var/lib/blakid/audit
# BLAKID_AUDIT_BUCKET=blakid-audit-ap-southeast-2

# Pinned authentik image digest (source of truth also in packages/config)
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server@sha256:ab9b4e8cc4ab3f8d1198d2db6aeea66bafea1963b3f2843589e0d163f97d9849

# Docker context for tenant stacks (leave empty for current context)
BLAKID_DOCKER_HOST=

# Optional: local operator bootstrap for memory runtime only
BLAKID_BOOTSTRAP_OPERATOR_EMAIL=josh@yuma.example
BLAKID_BOOTSTRAP_OPERATOR_NAME=Josh
BLAKID_BOOTSTRAP_OPERATOR_PASSWORD=change-me-operator

# Do not commit real tokens. Tenant bootstrap tokens live in gitignored tenant dirs.
